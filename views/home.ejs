<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard · Short URL</title>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="brand"><span class="logo">🔗</span> Short URL</div>
    </nav>

    <div class="page">
      <div class="page-header">
        <h1>Your links</h1>
        <p>Shorten a URL and keep track of how many times it's clicked.</p>
      </div>

      <div class="panel">
        <h2>Create a new short link</h2>
        <form class="url-form" method="POST" action="/url">
          <input
            type="text"
            name="url"
            placeholder="https://example.com/a-very-long-url"
            required
          />
          <button type="submit">Shorten</button>
        </form>

        <% if (locals.id) { %>
        <div class="result-banner">
          ✅ Short URL created:
          <a href="/url/<%= id %>" target="_blank">/url/<%= id %></a>
        </div>
        <% } %>
      </div>

      <div class="panel">
        <h2>All links</h2>
        <% if (locals.urls && urls.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Short Link</th>
              <th>Destination</th>
              <th>Clicks</th>
            </tr>
          </thead>
          <tbody>
            <% urls.forEach((url, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td>
                <a class="short-link" href="/url/<%= url.shortId %>" target="_blank"
                  >/url/<%= url.shortId %></a
                >
              </td>
              <td><%= url.redirectURL %></td>
              <td><span class="badge"><%= url.visitHistory.length %></span></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <div class="empty-state">No links yet — create your first one above.</div>
        <% } %>
      </div>
    </div>
  </body>
</html>
