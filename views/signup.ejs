<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up · Short URL</title>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="brand"><span class="logo">🔗</span> Short URL</div>
      <div class="nav-links">
        <a href="/login" class="pill">Log in</a>
      </div>
    </nav>

    <div class="auth-wrapper">
      <div class="auth-card">
        <h1>Create your account</h1>
        <p class="subtitle">Start shortening and tracking your links.</p>

        <form action="/user" method="post">
          <div class="field">
            <label>Full Name</label>
            <input type="text" required name="name" placeholder="Jane Doe" />
          </div>
          <div class="field">
            <label>Email</label>
            <input type="text" required name="email" placeholder="you@example.com" />
          </div>
          <div class="field">
            <label>Password</label>
            <input type="password" required name="password" placeholder="••••••••" />
          </div>
          <button type="submit" class="btn">Sign Up</button>
        </form>

        <div class="auth-footer">
          Already have an account? <a href="/login">Log in</a>
        </div>
      </div>
    </div>
  </body>
</html>
